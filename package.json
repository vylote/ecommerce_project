{
  "devDependencies": {
    "concurrently": "^10.0.3"
  },
  "scripts": {
    "dev": "concurrently --names api,web,realtime \"npm run dev:api\" \"npm run dev:web\" \"npm run dev:realtime\"",
    "dev:api": "cd apps/api && ./mvnw spring-boot:run",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:realtime": "npm --prefix apps/realtime-gateway run dev",
    "build:web": "npm --prefix apps/web run build",
    "build:api": "cd apps/api && ./mvnw package -DskipTests",
    "test:api": "cd apps/api && ./mvnw test"
  }
}
